# ============================================================
# esim.gg 选号兑换系统 — 环境变量示例 (规格 §53)
# 复制为 .env 并填写真实值; 切勿把真实 API Key 写入这里
# (esim.gg API Key 由管理员在后台 /admin 配置, 加密入库)
# ============================================================

# 数据库 (docker compose 内部网络)
POSTGRES_USER=esimgg
POSTGRES_PASSWORD=change-me-to-a-strong-password
POSTGRES_DB=esimgg

# 应用
APP_URL=https://esimgg.setup0.de

# 会话签名密钥 (>= 32 位随机字符串)
# 生成: openssl rand -base64 48
SESSION_SECRET=

# API Key 加密主密钥 (32 字节, 64 位 hex)
# 生成: openssl rand -hex 32
APP_ENCRYPTION_KEY=

# 首次启动创建的管理员 (创建后请尽快登录后台修改密码)
ADMIN_INITIAL_USERNAME=admin
ADMIN_INITIAL_PASSWORD=

# esim.gg API 基础地址 (一般无需修改)
ESIM_API_BASE_URL=https://api.esim.gg/api

# Cloudflare Turnstile 人机验证 (两项均留空则关闭校验)
# 站点密钥 (公开信息) 会经 /api/turnstile/config 下发给浏览器
# 密钥仅服务端使用, 用于调用 siteverify 校验
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
